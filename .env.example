# Copy to .env (in this folder, or ~/.forge/.env) and fill in your keys.
# Never commit .env. Only the last 4 characters of a key are ever printed.

# Failover order. Providers are tried left to right; any provider with no
# key below is skipped, so you can list all of them and fill in only some.
# Put the fastest / most generous ones first.
FORGE_PROVIDERS=groq,cerebras,nvidia,mistral,github,sambanova,huggingface,together,cohere,deepseek,openrouter,openai,gemini

# Keys: comma-separated, used round-robin. A key that hits a 429 is benched
# (60s for per-minute limits, until UTC midnight for daily limits, 1h for
# 401/403) and the next key or provider takes over.
# console.groq.com/keys
GROQ_API_KEYS=
# cloud.cerebras.ai
CEREBRAS_API_KEYS=
# build.nvidia.com (keys start nvapi-)
NVIDIA_API_KEYS=
# console.mistral.ai/api-keys
MISTRAL_API_KEYS=
# github.com/settings/tokens (fine-grained token with Models: read)
GITHUB_API_KEYS=
# cloud.sambanova.ai/apis
SAMBANOVA_API_KEYS=
# huggingface.co/settings/tokens
HUGGINGFACE_API_KEYS=
# api.together.ai/settings/api-keys
TOGETHER_API_KEYS=
# dashboard.cohere.com/api-keys
COHERE_API_KEYS=
# platform.deepseek.com/api_keys (paid)
DEEPSEEK_API_KEYS=
# openrouter.ai/keys
OPENROUTER_API_KEYS=
# platform.openai.com/api-keys (paid)
OPENAI_API_KEYS=
# aistudio.google.com/apikey
GEMINI_API_KEYS=

# Models. They MUST support tool calling, or the agent can't touch files
# or run commands. Change them any time with /model, list choices with /models.
# Providers retire models often; if one returns 404, pick another with /models.
GROQ_MODEL=openai/gpt-oss-120b
CEREBRAS_MODEL=gpt-oss-120b
NVIDIA_MODEL=minimaxai/minimax-m3.1-flash
MISTRAL_MODEL=mistral-medium-latest
GITHUB_MODEL=openai/gpt-4.1
SAMBANOVA_MODEL=Meta-Llama-3.3-70B-Instruct
HUGGINGFACE_MODEL=openai/gpt-oss-120b
TOGETHER_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo
COHERE_MODEL=command-a-03-2025
DEEPSEEK_MODEL=deepseek-chat
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENAI_MODEL=gpt-4.1-mini
GEMINI_MODEL=gemini-2.5-flash

# Any other OpenAI-compatible provider works too: add its name to
# FORGE_PROVIDERS and set <NAME>_BASE_URL, <NAME>_MODEL and <NAME>_API_KEYS.
#   FORGE_PROVIDERS=groq,...,myhost
#   MYHOST_BASE_URL=https://example.com/v1
#   MYHOST_MODEL=some-model
#   MYHOST_API_KEYS=...

# Shell for run_shell: powershell (Windows default), pwsh, cmd, bash
# FORGE_SHELL=powershell

# Tuning (defaults shown)
# FORGE_MAX_TOKENS=4096
# FORGE_TIMEOUT=30          # seconds of silence before moving to the next provider
# FORGE_STREAM=1            # show replies as they are written (0 = wait for the full reply)
# FORGE_ROUTING=quality     # most capable model first, kept for the whole task (speed = fastest first)
# FORGE_COURIER_ROWS=8    # size of the pixel courier on the status line (6-16 in pixels, 5-12 half-block; default follows window height)
# FORGE_COURIER=off       # one-line wheelbarrow instead of the pixel courier
# FORGE_COURIER_HD=off    # half-block courier instead of real pixels (sixel; default on in Windows Terminal)
# FORGE_CELL_PX=10x20     # pixel size of one character cell, for the pixel courier
# FORGE_SCENE=city         # also show the big pixel city above the message box (default: just the wheelbarrow)
# FORGE_MOTION=full        # reduce = still frames, no walking or blinking
# FORGE_GRAPHICS=auto      # sixel (high-res banner) | blocks (half-block pixels) | plain
# FORGE_AUTO_BENCH=1       # quick background test of new models (2 tiny requests each) to measure their score
# FORGE_FASTEST_FIRST=1     # among equally capable models, try the fastest first (0 = FORGE_PROVIDERS order)
# FORGE_KEYS_PER_PROVIDER=4
# FORGE_RETRY_ROUNDS=3
# FORGE_MAX_CONTINUATIONS=3
# FORGE_MAX_STEPS=40
# FORGE_MAX_AGENTS=5
# Team mode: a coordinator model hands tasks to the models best at them (/team on, forge -t).
# FORGE_TEAM=on
# FORGE_COORDINATOR=groq:openai/gpt-oss-120b
# Extra models per provider (comma list) join the roster: <NAME>_MODELS=a,b
# FORGE_CONTEXT_CHARS=150000

# When to ask before acting: smart (only risky commands / writes outside the folder), ask (everything), auto (nothing)
# FORGE_APPROVAL=smart

# Open pages/servers a turn built in the browser automatically (1 = on)
FORGE_AUTO_OPEN=1

# Load the skill a request needs automatically (1 = on)
FORGE_AUTO_SKILL=1

# When every model is resting after rate limits, wait this many seconds for one to come back
FORGE_MAX_WAIT=150

# Keyless free gateways (kilo, llm7, ovh) as the last fallback (1 = on)
FORGE_KEYLESS=1

# More free providers (add keys to enable): ZAI_API_KEYS=, GONKA_API_KEYS=, AION_API_KEYS=,
# MODELSCOPE_API_KEYS=, SILICONFLOW_API_KEYS=

# --- Sandbox: run the model's shell commands inside Docker (needs Docker Desktop running) ---
# FORGE_SANDBOX=docker             # the container only sees the project folder
# FORGE_SANDBOX_IMAGE=node:22-bookworm
# FORGE_SANDBOX_NET=none           # no network inside the container (default: network on)
# FORGE_SANDBOX_PORTS=5173,3000,8000,8080   # ports published to 127.0.0.1 only
# FORGE_SANDBOX_MEMORY=4g

# Give each /parallel agent its own git worktree and branch (needs a git repo with one commit)
# FORGE_WORKTREES=1

# GitHub sign-in with a device code (/github login): the client id of a GitHub OAuth App
# with "Enable Device Flow" ticked. A client id is public, not a secret.
# FORGE_GITHUB_CLIENT_ID=

# Browser used for browser_check screenshots when Playwright isn't installed (default: Edge or Chrome)
# FORGE_BROWSER=C:\Program Files\Google\Chrome\Application\chrome.exe

# Sponsor line on the goodbye screen. Off unless an ad server and its public key are set.
# FORGE_ADS=0                      # never show one (same as /ads off)
# FORGE_ADS_URL=https://forge-ads.example.workers.dev
# FORGE_ADS_KEY=                   # hex public key from `python -m forgecli.ads keygen`
